<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\TypstInterop\TypstInterop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net11.0;net10.0;net48</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>

  <!-- Competitor: typstsharp (https://github.com/evolvedlight/typstsharp).
       Scoped to the .NET (Core) TFMs: the package targets net8.0/9.0/10.0 (net11.0
       resolves to its net10.0 asset) and ships native (P/Invoke) binaries, so it
       is not usable on net48. The
       HAS_TYPSTSHARP symbol guards CompetitorBenchmarks.cs - drop this
       ItemGroup and the suite still builds/runs without the competitor rows.

       The version is overridable (-p:TypstSharpVersion=0.14.1) so you can
       compare across typstsharp releases - see wiki/Benchmarks.md for the
       exact command.
       Default is 0.15.1.3: it wraps the same Typst version (0.15.1) as this
       library, and ships linux-x64 + win-x64 natives (no macOS / arm64).
       0.14.2.2 shipped ONLY win-x64; other versions known to ship linux-x64 +
       win-x64: 0.15.1.1, 0.14.2, 0.14.1, 0.0.8.
       The FromSource(source, fonts, sysInputs, root) API used here is stable
       across 0.14.1 through 0.15.1.3. -->
  <PropertyGroup>
    <TypstSharpVersion Condition="'$(TypstSharpVersion)' == ''">0.15.1.3</TypstSharpVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' != '' and $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <PackageReference Include="typstsharp" Version="$(TypstSharpVersion)" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetFramework)' != '' and $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <DefineConstants>$(DefineConstants);HAS_TYPSTSHARP</DefineConstants>
  </PropertyGroup>
</Project>
