{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 10,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Automerge non-major updates once required checks pass; majors stay manual.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Bump the entire Typst crate family together; they share a version and must stay in lockstep. Typst 0.x minors are breaking, so never automerge.",
      "matchManagers": [
        "cargo"
      ],
      "matchPackageNames": [
        "/^typst(-|$)/"
      ],
      "groupName": "typst",
      "automerge": false
    },
    {
      "description": "Group the .NET test toolchain into a single PR.",
      "matchManagers": [
        "nuget"
      ],
      "matchPackageNames": [
        "/^xunit\\.v3/",
        "/^Microsoft\\.Testing\\./"
      ],
      "groupName": "dotnet test dependencies"
    },
    {
      "description": "Group the .NET Framework / netstandard compatibility shims.",
      "matchManagers": [
        "nuget"
      ],
      "matchPackageNames": [
        "System.Memory",
        "System.Buffers",
        "System.Runtime.CompilerServices.Unsafe"
      ],
      "groupName": "dotnet compatibility shims"
    },
    {
      "description": "Group GitHub Actions updates.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Bump the .NET SDK container image in one PR across the Dockerfile and workflows.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mcr.microsoft.com/dotnet/sdk"
      ],
      "groupName": "dotnet sdk image"
    }
  ],
  "platformAutomerge": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ],
    "automerge": true
  }
}
